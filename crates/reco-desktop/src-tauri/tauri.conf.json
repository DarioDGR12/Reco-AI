{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reco AI",
  "version": "0.2.0",
  "identifier": "ai.reco.prueba",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Prueba — Reco AI",
        "width": 1100,
        "height": 740,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net"
    ]
  }
}
