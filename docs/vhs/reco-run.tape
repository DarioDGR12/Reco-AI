# reco run dry-run (resolve + destination, no download)
# vhs docs/vhs/reco-run.tape

Output docs/assets/demo-reco-run.gif
Set FontFamily "JetBrains Mono"
Set FontSize 15
Set Width 980
Set Height 420
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms

Sleep 400ms
Type "reco run Llama-3.1-8B --offline --fixture rtx4060 --dry-run"
Sleep 200ms
Enter
Sleep 2s
