# Reco AI hero: hardware detection + upcoming recommendations.
# Regenerate: vhs docs/vhs/reco-ai.tape
# Requires `reco` on PATH (cargo install --path crates/reco-cli).

Output docs/assets/demo-reco-ai.gif
Set FontFamily "JetBrains Mono"
Set FontSize 15
Set Width 980
Set Height 520
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 55ms
Set PlaybackSpeed 0.9

Sleep 400ms
Type "reco ai"
Sleep 250ms
Enter
Sleep 3s
